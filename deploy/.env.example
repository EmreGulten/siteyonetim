# ============================================================
#  Site & Apartman Yönetim Sistemi — Ortam Değişkenleri
#  KULLANIM:  cp .env.example .env  → değerleri doldur
#  ⚠️  .env dosyasını ASLA git'e commit'leme!
# ============================================================

# ---- Genel ----
COMPOSE_PROJECT_NAME=siteyonetim
TZ=Europe/Istanbul
# Üretim domaini (Nginx + SSL için):
DOMAIN=api.sitendeavoir.com
# CORS — mobil + yönetim domainleri (virgülle ayır)
CORS_ALLOWED_ORIGINS=https://panel.siten.com,com.sitendeavoir.app

# ---- PostgreSQL ----
POSTGRES_DB=siteyonetim
POSTGRES_USER=siteyonetim_app
# En az 32 karakter güçlü parola üret:  openssl rand -base64 32
POSTGRES_PASSWORD=DEGISTIR_BENI_cok_uzun_guclu_parola_32karakter

# ---- .NET Core API ----
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080
# EF Core bağlantı dizesi (docker servisi adı = db)
ConnectionStrings__DefaultConnection=Host=db;Port=5432;Database=${POSTGRES_DB};Username=${POSTGRES_USER};Password=${POSTGRES_PASSWORD};Include Error Detail=true;Pooling=true;
# JWT (en az 512 bit = 64 bayt anahtar):  openssl rand -base64 64
Jwt__Issuer=siteyonetim-api
Jwt__Audience=siteyonetim-mobile
Jwt__Key=DEGISTIR_BENI_jwt_icin_cok_guclu_en_az_64_bayt_anahtar_xxxxxxxxxxxx
Jwt__AccessTokenMinutes=60
Jwt__RefreshTokenDays=30

# ---- MinIO (S3 uyumlu nesne depolama) ----
MINIO_ROOT_USER=siteyonetim_minio
# En az 8 karakter güçlü parola:
MINIO_ROOT_PASSWORD=DEGISTIR_BENI_minio_gizli_8_karakter
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# API'nin MinIO'ya bağlanırken kullandığı bucket (başlangıçta otomatik oluşturulur)
MINIO_BUCKET=siteyonetim-docs
# Mobil/resmi makbuz URL'leri için dış erişilebilir base URL (Nginx arkası):
MINIO_PUBLIC_BASE_URL=https://${DOMAIN}/storage

# ---- pgAdmin (opsiyonel) ----
PGADMIN_DEFAULT_EMAIL=admin@sitendeavoir.com
PGADMIN_DEFAULT_PASSWORD=DEGISTIR_BENI_pgadmin_parola

# ---- In-App Purchase doğrulama (Faz 5 — şimdilik yer tutucu) ----
# Google Play
GOOGLE_PLAY_PACKAGE_NAME=com.sitendeavoir.app
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON_PATH=/app/secrets/google-play-sa.json
# Apple
APPLE_BUNDLE_ID=com.sitendeavoir.app
APPLE_SHARED_SECRET=DEGISTIR_BENI_apple_shared_secret
